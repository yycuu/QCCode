    "directory": "packages/security"
  },
  "homepage": "https://github.com/yycuu/QCCode#readme",
  "bugs": {
    "url": "https://github.com/yycuu/QCCode/issues"
  },
  "keywords": [
    "qccode",
    "visual-code",
    "barcode",
    "ed25519"
  ],
  "publishConfig": {
