{
  "name": "@qccode/decoder",
  "version": "0.3.1",
  "description": "QCCode symbol decoder with error and erasure correction.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yycuu/QCCode.git",
    "directory": "packages/decoder"
  },
  "homepage": "https://github.com/yycuu/QCCode#readme",
  "bugs": {
    "url": "https://github.com/yycuu/QCCode/issues"
  },
  "keywords": [
    "qccode",
    "visual-code",
    "barcode",
    "ed25519"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@qccode/core": "workspace:*",
    "@qccode/geometry": "workspace:*",
    "@qccode/protocol": "workspace:*"
  },
  "license": "MIT"
}
