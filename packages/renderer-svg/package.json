{
  "name": "@qccode/renderer-svg",
  "version": "0.1.0",
  "description": "Render accessible QCCode symbols as SVG with themes and center logos.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yycuu/QCCode.git",
    "directory": "packages/renderer-svg"
  },
  "homepage": "https://github.com/yycuu/QCCode#readme",
  "bugs": {
    "url": "https://github.com/yycuu/QCCode/issues"
  },
  "keywords": [
    "qccode",
    "visual-code",
    "barcode",
    "ed25519"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@qccode/geometry": "workspace:*"
  }
}
