{
  "name": "qccode",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm build && pnpm --filter @qccode/demo dev",
    "server": "pnpm build && pnpm --filter @qccode/reference-server dev",
    "vectors": "tsx scripts/generate-vectors.ts",
    "pack:npm": "node scripts/publish-packages.mjs",
    "release:npm": "node scripts/publish-packages.mjs --publish"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
